node_modules/
.env
dist/
infra/cdk.out/
*.vsix
.DS_Store

# Your deployment's settings: domain, hosted zone, AWS profile, git identity.
# Ignored so a fork never publishes one person's account details — copy
# triplec.config.example.json to create it.
triplec.config.json

# A second deployment is a second config file, named and pointed at with
# TRIPLEC_CONFIG (see docs/DEPLOY.md). Ignored for exactly the same reason as
# the one above, and matched by pattern so adding another cannot be forgotten.
triplec.*.config.json

# The same two under the name this project used before the rename. Still read by
# infra/config.js, because a config file lives only on the machines that deploy and
# no rename in here can reach them — so they must stay ignored for as long as they
# stay loadable, or the first commit after a rename publishes someone's account.
claude-web.config.json
claude-web.*.config.json

# CDK caches Route53/AZ lookups here, and those cache entries embed your AWS
# account id. Regenerated on demand, so there is no reason to commit it.
infra/cdk.context.json

# Which build is running, written into the *staged* payload by deploy.sh — see
# chat-service/build.js. It should never exist in a checkout, and a committed one
# would be worse than none: every box would then report the build of whoever
# committed it, confidently and forever.
chat-service/build.json

# Copied in from pwa/ + pwa-icons/ by deploy.sh. pwa/ is the source of truth;
# committing both copies lets them drift.
chat-service/public/manifest.webmanifest
chat-service/public/sw.js
chat-service/public/pwa-icons/
