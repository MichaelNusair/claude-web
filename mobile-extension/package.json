{
  "name": "claude-mobile-shell",
  "displayName": "Claude Mobile Shell",
  "description": "Opens the Claude Code panel full-screen and strips VS Code chrome for phone use",
  "version": "1.0.0",
  "publisher": "claude-web",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeMobile.focusClaude",
        "title": "Mobile: Open Claude full screen"
      },
      {
        "command": "claudeMobile.backToClaude",
        "title": "Mobile: Back to Claude (close open files)"
      },
      {
        "command": "claudeMobile.toggleChrome",
        "title": "Mobile: Toggle editor chrome"
      }
    ],
    "keybindings": [
      {
        "command": "claudeMobile.backToClaude",
        "key": "ctrl+alt+shift+f9"
      },
      {
        "command": "claudeMobile.toggleChrome",
        "key": "ctrl+alt+shift+f10"
      }
    ],
    "configuration": {
      "title": "Claude Mobile Shell",
      "properties": {
        "claudeMobile.closeFilesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Close restored files and diffs when the workbench starts, so reloading the page recovers a layout that a file view has taken over. Turn this off to keep your open editors across reloads."
        }
      }
    }
  }
}
