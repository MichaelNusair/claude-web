{
  "name": "triplec",
  "version": "3.0.0",
  "description": "TripleC — Claude Code on a machine of its own: a chat app and web IDE that a session outlives the device it started on. Self-host it, or have it managed.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://triplec.host",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelNusair/triplec.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "./deploy.sh",
    "synth": "cd infra && npx cdk synth",
    "destroy": "cd infra && npx cdk destroy",
    "config": "node infra/print-config.js",
    "test": "npm run test:auth && npm run test:client && npm run test:panes && npm run test:read && npm run test:talk && npm run test:overlay && npm run test:polish && npm run test:speak && npm run test:realtime && npm run test:transcribe && npm run test:azure && npm run test:projects && npm run test:manifest && npm run test:build && npm run test:admin && npm run test:status && npm run test:push && npm run test:sw && npm run test:turns && npm run test:broker && npm run test:landing",
    "test:auth": "cd chat-service && node auth-test.js",
    "test:client": "cd chat-service && node smoke-test.js",
    "test:panes": "cd chat-service && node pane-test.js",
    "test:read": "cd chat-service && node read-test.js",
    "test:talk": "cd chat-service && node talk-test.js",
    "test:overlay": "cd chat-service && node overlay-test.js",
    "test:polish": "cd chat-service && node polish-test.js",
    "test:speak": "cd chat-service && node speak-test.js",
    "test:realtime": "cd chat-service && node realtime-test.js",
    "test:transcribe": "cd chat-service && node transcribe-test.js",
    "test:azure": "cd chat-service && node azure-speech-test.js",
    "test:projects": "cd chat-service && node project-test.js",
    "test:manifest": "cd chat-service && node manifest-test.js",
    "test:build": "cd chat-service && node build-test.js",
    "test:admin": "cd chat-service && node admin-test.js",
    "test:status": "cd chat-service && node status-test.js",
    "test:push": "cd chat-service && node push-test.js",
    "test:sw": "cd chat-service && node sw-test.js",
    "test:turns": "cd chat-service && node turn-watcher-test.js",
    "test:broker": "node claude-broker/broker-test.js",
    "test:landing": "node landing/landing-test.js",
    "package-voice": "cd voice-extension && npx --yes @vscode/vsce@latest package --skip-license --allow-missing-repository --out ../dist/claude-voice.vsix"
  }
}
