{
  "name": "claude-web",
  "version": "3.0.0",
  "description": "Self-hosted Claude Code as a chat app and web IDE, on your own AWS account",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "./deploy.sh",
    "synth": "cd infra && npx cdk synth",
    "destroy": "cd infra && npx cdk destroy",
    "config": "node infra/print-config.js",
    "test": "npm run test:auth && npm run test:client && npm run test:panes && npm run test:overlay && npm run test:polish && npm run test:projects && npm run test:admin && npm run test:broker",
    "test:auth": "cd chat-service && node auth-test.js",
    "test:client": "cd chat-service && node smoke-test.js",
    "test:panes": "cd chat-service && node pane-test.js",
    "test:overlay": "cd chat-service && node overlay-test.js",
    "test:polish": "cd chat-service && node polish-test.js",
    "test:projects": "cd chat-service && node project-test.js",
    "test:admin": "cd chat-service && node admin-test.js",
    "test:broker": "node claude-broker/broker-test.js",
    "package-voice": "cd voice-extension && npx --yes @vscode/vsce@latest package --skip-license --allow-missing-repository --out ../dist/claude-voice.vsix"
  }
}
