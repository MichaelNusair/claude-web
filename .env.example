# Local development only.
#
# A real deployment does not use this file. deploy.sh generates the password and
# session secret into AWS Secrets Manager, and bootstrap.sh writes them to
# /etc/claude-auth.env on the instance. Nothing here is read in production.
#
# This is for running the chat service on your laptop:
#
#   cd chat-service && npm install
#   env $(grep -v '^#' ../.env.example | xargs) node server.js
#
# Deployment settings live in triplec.config.json — see
# triplec.config.example.json.

# --- Required: the server refuses to start without these -------------------
# Both must be at least 16 characters. This is deliberate; the service executes
# shell commands, so it will not run in an unauthenticated state.
AUTH_PASSWORD=change-me-to-something-long
SESSION_SECRET=change-me-to-a-long-random-string

# Drops the `Secure` flag on the session cookie so it works over plain HTTP on
# localhost. NEVER set this on anything reachable from a network — it lets the
# session cookie travel in the clear.
CW_INSECURE_COOKIES=1

# --- Optional ---------------------------------------------------------------
PORT=9997

# Where projects live. On the instance this is /workspace/projects.
PROJECTS_ROOT=/tmp/triplec-projects

# Claude Code's state directory. On the instance this is /workspace/claude.
# CLAUDE_HOME=/Users/you/.claude

# "password" (default) or "oidc". OIDC expects an AWS load balancer in front and
# has no meaning locally.
CW_AUTH_MODE=password

# Claude Code talks to Bedrock via the instance role in a deployment. Locally it
# uses whatever credentials your AWS CLI is configured with.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
ANTHROPIC_MODEL=us.anthropic.claude-opus-5
